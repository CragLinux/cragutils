# glibc build environment: gcc, clang, sanitizers and libFuzzer.
#
# Used for the gcc, clang, sanitizers, fuzz, hardening and zig jobs.
FROM registry.fedoraproject.org/fedora:latest

RUN dnf -y install --setopt=install_weak_deps=False \
        gcc gcc-c++ clang clang-analyzer compiler-rt llvm \
        meson ninja-build pkgconf-pkg-config \
        flex byacc bison \
        libxo-devel \
        ncurses-devel libedit-devel openssl-devel \
        zlib-devel bzip2-devel xz-devel libzstd-devel libacl-devel \
        libselinux-devel \
        binutils file diffutils findutils grep sed gawk which \
        hostname words \
        git curl ca-certificates \
    && dnf clean all

# zig: pinned release (see README.md; distro packages are too old
# for build.zig).  Releases stay on ziglang.org permanently; the tarball
# is sha256-verified here.
ARG ZIG_VERSION=0.17.1
ARG ZIG_SHA256=3581863e3cbcfd0fce0efc682ce7e9e93da96668a977791d356a26d2a7e9b17a
RUN curl -fsSL -o /tmp/zig.tar.xz \
        "https://ziglang.org/download/${ZIG_VERSION}/zig-x86_64-linux-${ZIG_VERSION}.tar.xz" \
    && echo "${ZIG_SHA256}  /tmp/zig.tar.xz" | sha256sum -c - \
    && tar -xf /tmp/zig.tar.xz -C /usr/local \
    && ln -s "/usr/local/zig-x86_64-linux-${ZIG_VERSION}/zig" /usr/local/bin/zig \
    && rm -f /tmp/zig.tar.xz

# The suite runs unprivileged so that permission-dependent tests (which
# skip when running as root) actually execute.
RUN useradd -m build
WORKDIR /src
USER build
