# patch differential cases — see tests/diff/README.md for the format.
# fields: id<TAB>argv<TAB>stdin<TAB>env<TAB>hints
p1-apply	patch -p1 -N	@p1.diff	-	post:src/hello.c
p1-dryrun	patch -p1 -N --dry-run	@p1.diff	-	post:src/hello.c
p1-reverse	patch -p1 -R -N	@p1.diff	-	post:src/hello.c
p1-already	patch -p1 -N	@p1.diff	-	post:src/hello.c
bad-hunk	patch -p1 -N	@bad.diff	-	post:src/hello.c
ctx-p0	patch -p0 -N	@ctx.diff	-	post:f
